# MarketFlow — Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=marketflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=marketflow
DATABASE_URL=postgresql+asyncpg://marketflow:CHANGE_ME_STRONG_PASSWORD@timescaledb:5432/marketflow

# ── Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=GENERATE_ME_32_BYTES_BASE64

# Generate: openssl rand -hex 64
JWT_SECRET_KEY=GENERATE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ────────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ─────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=marketflow
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ── Marketplace API Base URLs (SSRF whitelist) ────────────────────────────
WB_API_BASE=https://api.wildberries.ru
OZON_API_BASE=https://api-seller.ozon.ru
YM_API_BASE=https://api.partner.market.yandex.ru
MM_API_BASE=https://api.megamarket.ru

# ── Telegram (for bid optimizer notifications) ────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_CHAT_ID

# ── App Config ────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ── Rate Limits ───────────────────────────────────────────────────────────
XRAY_RATE_LIMIT_UNAUTH=3  # requests per IP per hour
API_RATE_LIMIT_AUTH=100   # requests per user per minute
