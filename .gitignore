# MarketFlow .gitignore

# ── Environment & Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
*.env
!.env.example

# CRITICAL: Never commit API keys or encryption keys
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/

# pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ── Node.js / Next.js ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# ── Docker ────────────────────────────────────────────────────────────────
# Keep docker-compose.yml — it's part of the repo
# But ignore local override files
docker-compose.override.yml
docker-compose.local.yml

# ── Database ──────────────────────────────────────────────────────────────
*.db
*.sqlite3
*.sql
!db/init/*.sql  # Keep init scripts

# Alembic
# Keep migrations — they're part of the repo

# ── IDE & OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
nginx/logs/

# ── Testing artifacts ──────────────────────────────────────────────────────
.locust/
locust-results/

# ── MinIO local data (Docker volumes manage this) ─────────────────────────
minio-data/

# ── Security scan baseline (keep, but don't commit accidentally updated) ───
# .secrets.baseline  # uncomment if using detect-secrets

# ── Temp / Cache ───────────────────────────────────────────────────────────
.cache/
tmp/
temp/
*.tmp
*.bak
*.backup

# ── Claude Code ───────────────────────────────────────────────────────────
# Keep all .claude/ files — they're part of the toolkit
# But ignore local session data if any
.claude/tmp/
